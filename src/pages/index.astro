---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import { company } from '../content/company';

const year = new Date().getFullYear();
---

<Layout>
  <Header />

  <main id="top">
    <!-- Masthead -->
    <section class="border-b border-line">
      <div class="mx-auto max-w-4xl px-6 pt-16 pb-14 md:pt-20">
        <p class="text-[13px] font-medium tracking-wide text-muted uppercase">
          {company.tagline}
        </p>
        <h1 class="mt-4 max-w-2xl font-serif text-4xl leading-[1.15] font-semibold tracking-tight text-ink md:text-5xl">
          {company.hero.heading}
        </h1>
        <p class="mt-5 max-w-xl text-[17px] leading-relaxed text-muted">{company.hero.sub}</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-3">
          <a
            href="#contact"
            class="bg-forest px-6 py-3 text-sm font-medium text-paper transition hover:bg-forest-dark"
          >
            Contact us
          </a>
          <a href="#market" class="text-sm font-medium text-forest underline underline-offset-4 hover:text-forest-dark">
            Read the market brief
          </a>
        </div>
      </div>
    </section>

    <!-- Capital Market -->
    <Section id="market" num="01" heading="Nepal's Capital Market">
      <div class="max-w-2xl space-y-4 text-[15px] leading-relaxed">
        {company.market.intro.map((p) => <p>{p}</p>)}
      </div>

      <h3 class="mt-12 font-serif text-lg font-semibold text-ink">In-depth market analysis</h3>
      <div class="mt-4 max-w-2xl divide-y divide-line">
        {company.market.analysis.map((a) => (
          <div class="py-5">
            <h4 class="text-sm font-semibold text-forest">{a.title}</h4>
            <p class="mt-1.5 text-[15px] leading-relaxed text-muted">{a.body}</p>
          </div>
        ))}
      </div>

      <h3 class="mt-12 font-serif text-lg font-semibold text-ink">Sector weightings</h3>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full min-w-[640px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-y border-ink">
              <th class="py-2.5 pr-6 font-semibold">Sector</th>
              <th class="py-2.5 pr-6 font-semibold">Approx. market cap (mid-March 2026)</th>
              <th class="py-2.5 font-semibold">Structural trend</th>
            </tr>
          </thead>
          <tbody>
            {company.market.sectors.map((s) => (
              <tr class="border-b border-line align-top">
                <td class="py-3 pr-6 font-medium text-ink">{s.name}</td>
                <td class="py-3 pr-6 text-muted">{s.cap}</td>
                <td class="py-3 text-muted">{s.trend}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 max-w-2xl text-xs text-muted">{company.market.sectorNote}</p>

      <h3 class="mt-12 font-serif text-lg font-semibold text-ink">Structural considerations</h3>
      <dl class="mt-4 max-w-2xl divide-y divide-line">
        {company.market.considerations.map((c) => (
          <div class="grid gap-1 py-4 md:grid-cols-[220px_1fr] md:gap-6">
            <dt class="text-sm font-semibold text-ink">{c.title}</dt>
            <dd class="text-[15px] leading-relaxed text-muted">{c.body}</dd>
          </div>
        ))}
      </dl>
    </Section>

    <!-- Share Market -->
    <Section id="share-market" num="02" heading="The Share Market">
      <p class="max-w-2xl text-[15px] leading-relaxed">{company.shareMarket.intro}</p>
      <dl class="mt-8 max-w-2xl divide-y divide-line">
        {company.shareMarket.features.map((f) => (
          <div class="grid gap-1 py-4 md:grid-cols-[220px_1fr] md:gap-6">
            <dt class="text-sm font-semibold text-ink">{f.title}</dt>
            <dd class="text-[15px] leading-relaxed text-muted">{f.body}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-8 max-w-2xl border-l-2 border-forest pl-5 text-[15px] leading-relaxed text-ink">
        {company.shareMarket.closing}
      </p>
    </Section>

    <!-- Opportunities -->
    <Section id="opportunities" num="03" heading="Investment Opportunities">
      <p class="max-w-2xl text-[15px] leading-relaxed">{company.opportunities.intro}</p>
      <dl class="mt-8 max-w-2xl divide-y divide-line">
        {company.opportunities.items.map((o) => (
          <div class="grid gap-1 py-4 md:grid-cols-[220px_1fr] md:gap-6">
            <dt class="text-sm font-semibold text-ink">{o.title}</dt>
            <dd class="text-[15px] leading-relaxed text-muted">{o.body}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-8 max-w-2xl border-l-2 border-forest pl-5 text-[15px] leading-relaxed text-ink">
        {company.opportunities.closing}
      </p>
    </Section>

    <!-- FDI -->
    <Section id="fdi" num="04" heading="Foreign Direct Investment">
      <p class="max-w-2xl text-[15px] leading-relaxed">{company.fdi.intro}</p>
      <dl class="mt-8 max-w-2xl divide-y divide-line">
        {company.fdi.highlights.map((h) => (
          <div class="grid gap-1 py-4 md:grid-cols-[220px_1fr] md:gap-6">
            <dt class="text-sm font-semibold text-ink">{h.title}</dt>
            <dd class="text-[15px] leading-relaxed text-muted">{h.body}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-8 max-w-2xl border-l-2 border-forest pl-5 text-[15px] leading-relaxed text-ink">
        {company.fdi.closing}
      </p>
    </Section>

    <!-- About -->
    <Section id="about" num="05" heading={company.about.heading}>
      <div class="grid gap-10 md:grid-cols-[1fr_1fr]">
        <p class="text-[15px] leading-relaxed text-muted">{company.about.body}</p>
        <dl class="divide-y divide-line border-y border-line">
          {company.about.points.map((p) => (
            <div class="py-3.5">
              <dt class="text-sm font-semibold text-ink">{p.title}</dt>
              <dd class="mt-0.5 text-sm leading-relaxed text-muted">{p.body}</dd>
            </div>
          ))}
        </dl>
      </div>
    </Section>

    <!-- Contact -->
    <Section id="contact" num="06" heading="Contact">
      <div class="max-w-2xl">
        <p class="text-[15px] leading-relaxed text-muted">
          Write or call to discuss mandates, minimum engagement terms, or an FDI enquiry.
        </p>
        <dl class="mt-8 divide-y divide-line border-y border-line text-[15px]">
          <div class="grid gap-1 py-4 md:grid-cols-[140px_1fr]">
            <dt class="text-sm font-semibold text-ink">Email</dt>
            <dd>
              <a href={`mailto:${company.email}`} class="text-forest underline underline-offset-4 hover:text-forest-dark">
                {company.email}
              </a>
            </dd>
          </div>
          {company.phones.map((p) => (
            <div class="grid gap-1 py-4 md:grid-cols-[140px_1fr]">
              <dt class="text-sm font-semibold text-ink">Telephone</dt>
              <dd>
                <a href={`tel:${p.tel}`} class="text-ink hover:text-forest">{p.display}</a>
              </dd>
            </div>
          ))}
          <div class="grid gap-1 py-4 md:grid-cols-[140px_1fr]">
            <dt class="text-sm font-semibold text-ink">Location</dt>
            <dd class="text-muted">Kathmandu, Nepal</dd>
          </div>
        </dl>
      </div>
    </Section>
  </main>

  <footer class="border-t border-line bg-forest-dark text-paper/70">
    <div class="mx-auto max-w-4xl px-6 py-10">
      <p class="max-w-3xl text-xs leading-relaxed">{company.disclaimer}</p>
      <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-paper/15 pt-5">
        <p class="text-xs">&copy; {year} {company.name}</p>
        <p class="text-xs">{company.domain}</p>
      </div>
    </div>
  </footer>
</Layout>
