---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import { company } from '../content/company';

const year = new Date().getFullYear();
---

<Layout>
  <Header />

  <main id="top">
    <!-- Hero -->
    <section class="relative overflow-hidden bg-navy-950 text-white">
      <svg
        class="absolute bottom-0 left-0 w-full text-navy-900"
        viewBox="0 0 1440 220"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path fill="currentColor" d="M0 220 L320 60 L520 160 L720 30 L940 170 L1140 80 L1440 200 L1440 220 Z" opacity="0.6" />
        <path fill="#16304f" d="M0 220 L220 120 L430 190 L660 70 L880 195 L1090 110 L1300 190 L1440 140 L1440 220 Z" />
      </svg>
      <div class="relative mx-auto max-w-5xl px-6 pt-40 pb-48 md:pt-48 md:pb-56">
        <p class="mb-4 text-sm font-semibold tracking-widest uppercase text-gold-400">
          Investment advisory · Kathmandu, Nepal
        </p>
        <h1 class="max-w-3xl font-serif text-4xl leading-tight font-semibold tracking-tight md:text-6xl">
          {company.hero.heading}
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-sand-100/80">{company.hero.sub}</p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a
            href="#contact"
            class="rounded-full bg-gold-400 px-7 py-3 text-sm font-semibold text-navy-950 transition hover:bg-gold-500"
          >
            Start a conversation
          </a>
          <a
            href="#market"
            class="rounded-full border border-white/25 px-7 py-3 text-sm font-semibold text-white transition hover:border-gold-400 hover:text-gold-400"
          >
            Explore the market
          </a>
        </div>
      </div>
    </section>

    <!-- Capital Market -->
    <Section id="market" eyebrow="The landscape" heading="Nepal's Capital Market">
      <div class="space-y-5 leading-relaxed">
        {company.market.intro.map((p) => <p>{p}</p>)}
      </div>

      <h3 class="mt-12 font-serif text-2xl font-semibold text-navy-900">In-depth market analysis</h3>
      <div class="mt-6 space-y-6">
        {company.market.analysis.map((a) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <h4 class="font-semibold text-navy-800">{a.title}</h4>
            <p class="mt-2 leading-relaxed text-slate-600">{a.body}</p>
          </div>
        ))}
      </div>

      <h3 class="mt-12 font-serif text-2xl font-semibold text-navy-900">From a banking market to a diversified one</h3>
      <div class="mt-6 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full min-w-[640px] text-left text-sm">
          <thead>
            <tr class="border-b border-slate-200 bg-navy-900 text-sand-50">
              <th class="px-5 py-3 font-semibold">Sector</th>
              <th class="px-5 py-3 font-semibold">Approx. market cap (mid-March 2026)</th>
              <th class="px-5 py-3 font-semibold">Structural trend</th>
            </tr>
          </thead>
          <tbody>
            {company.market.sectors.map((s, i) => (
              <tr class={i % 2 ? 'bg-sand-50' : 'bg-white'}>
                <td class="px-5 py-3 font-medium text-navy-800">{s.name}</td>
                <td class="px-5 py-3 text-slate-600">{s.cap}</td>
                <td class="px-5 py-3 text-slate-600">{s.trend}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-slate-500 italic">{company.market.sectorNote}</p>

      <h3 class="mt-12 font-serif text-2xl font-semibold text-navy-900">Structural considerations for investors</h3>
      <ul class="mt-6 grid gap-4 md:grid-cols-2">
        {company.market.considerations.map((c) => (
          <li class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <span class="font-semibold text-navy-800">{c.title}</span>
            <span class="text-slate-600"> {c.body}</span>
          </li>
        ))}
      </ul>
    </Section>

    <!-- Share Market -->
    <Section id="share-market" eyebrow="For individual investors" heading="The Share Market" dark>
      <p class="max-w-3xl leading-relaxed text-sand-100/85">{company.shareMarket.intro}</p>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {company.shareMarket.features.map((f) => (
          <div class="rounded-xl border border-white/10 bg-navy-800 p-6">
            <h3 class="font-serif text-lg font-semibold text-gold-400">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-sand-100/80">{f.body}</p>
          </div>
        ))}
      </div>
      <p class="mt-10 max-w-3xl border-l-2 border-gold-400 pl-5 leading-relaxed text-sand-100/90">
        {company.shareMarket.closing}
      </p>
    </Section>

    <!-- Opportunities -->
    <Section id="opportunities" eyebrow="Beyond the exchange" heading="Investment Opportunities in Nepal">
      <p class="max-w-3xl leading-relaxed">{company.opportunities.intro}</p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {company.opportunities.items.map((o) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="mb-3 h-1 w-10 rounded bg-gold-400"></div>
            <h3 class="font-serif text-lg font-semibold text-navy-900">{o.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{o.body}</p>
          </div>
        ))}
      </div>
      <p class="mt-10 max-w-3xl border-l-2 border-gold-400 pl-5 leading-relaxed text-slate-600">
        {company.opportunities.closing}
      </p>
    </Section>

    <!-- FDI -->
    <Section id="fdi" eyebrow="For international investors" heading="Foreign Direct Investment in Nepal" dark>
      <p class="max-w-3xl leading-relaxed text-sand-100/85">{company.fdi.intro}</p>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {company.fdi.highlights.map((h, i) => (
          <div class="flex gap-4 rounded-xl border border-white/10 bg-navy-800 p-6">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gold-400 font-serif text-sm font-bold text-navy-950">
              {i + 1}
            </span>
            <div>
              <h3 class="font-semibold text-white">{h.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-sand-100/80">{h.body}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="mt-10 max-w-3xl border-l-2 border-gold-400 pl-5 leading-relaxed text-sand-100/90">
        {company.fdi.closing}
      </p>
    </Section>

    <!-- About -->
    <Section id="about" eyebrow="Who we are" heading={company.about.heading}>
      <div class="grid items-start gap-10 md:grid-cols-2">
        <p class="leading-relaxed text-slate-600">{company.about.body}</p>
        <ul class="space-y-4">
          {company.about.points.map((p) => (
            <li class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-gold-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.7-9.3a1 1 0 00-1.4-1.4L9 10.6 7.7 9.3a1 1 0 00-1.4 1.4l2 2a1 1 0 001.4 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span class="text-sm font-medium text-navy-800">{p}</span>
            </li>
          ))}
        </ul>
      </div>
    </Section>

    <!-- Contact -->
    <Section id="contact" eyebrow="Get in touch" heading="Start the climb" dark>
      <div class="grid gap-6 md:grid-cols-2">
        <a
          href={`mailto:${company.email}`}
          class="group rounded-2xl border border-white/10 bg-navy-800 p-8 transition hover:border-gold-400"
        >
          <h3 class="font-serif text-xl font-semibold text-gold-400">Email</h3>
          <p class="mt-2 break-all text-lg text-white group-hover:text-gold-400">{company.email}</p>
        </a>
        <div class="rounded-2xl border border-white/10 bg-navy-800 p-8">
          <h3 class="font-serif text-xl font-semibold text-gold-400">Telephone</h3>
          <ul class="mt-2 space-y-1 text-lg text-white">
            {company.phones.map((p) => (
              <li>
                <a href={`tel:${p.replace(/^0/, '+9771')}`} class="hover:text-gold-400">{p}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Section>
  </main>

  <footer class="bg-navy-950 text-sand-100/60">
    <div class="mx-auto max-w-5xl px-6 py-12">
      <p class="text-xs leading-relaxed">{company.disclaimer}</p>
      <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-6">
        <p class="text-sm">&copy; {year} {company.name}. All rights reserved.</p>
        <p class="text-sm">{company.domain}</p>
      </div>
    </div>
  </footer>
</Layout>
