---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import Motion from '../components/Motion.astro';
import { company } from '../content/company';

const year = new Date().getFullYear();
const site = Astro.site;
const jsonLd = JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'FinancialService',
          '@id': `${site}#organization`,
          name: company.name,
          description: 'Investment advisory in Kathmandu for NEPSE equities, debentures, mutual funds and foreign direct investment into Nepal.',
          url: String(site),
          logo: new URL('/og-image.png', site).href,
          image: new URL('/og-image.png', site).href,
          email: company.email,
          telephone: company.phones.map((p) => p.tel),
          address: {
            '@type': 'PostalAddress',
            addressLocality: 'Kathmandu',
            addressCountry: 'NP',
          },
          openingHoursSpecification: [
            {
              '@type': 'OpeningHoursSpecification',
              dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
              opens: '09:00',
              closes: '17:00',
            },
          ],
          areaServed: { '@type': 'Country', name: 'Nepal' },
          priceRange: '$$',
        },
        {
          '@type': 'WebSite',
          '@id': `${site}#website`,
          url: String(site),
          name: company.name,
          publisher: { '@id': `${site}#organization` },
          inLanguage: 'en',
        },
      ],
    });
---

<Layout>
  <Header />

  <main id="top">
  <Motion />
    <!-- Hero: statement + live market snapshot -->
    <section class="border-b border-line bg-paper">
      <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 md:py-20 lg:grid-cols-[1.4fr_1fr] lg:items-center">
        <div>
          <p class="text-[11px] font-semibold tracking-[0.18em] text-navy uppercase">
            Investment advisory · Kathmandu · Est. in Nepal
          </p>
          <h1 class="mt-3 max-w-xl font-serif text-[38px] leading-[1.12] font-semibold tracking-tight text-ink md:text-[52px]">
            {company.hero.heading}
          </h1>
          <p class="mt-5 max-w-lg text-[17px] leading-relaxed text-muted">{company.hero.sub}</p>
          <div class="mt-7 flex flex-wrap gap-4">
            <a href="#contact" class="bg-navy px-6 py-3 text-sm font-medium text-white transition hover:bg-navy-dark">
              Speak with an advisor
            </a>
            <a href="#market" class="border border-line px-6 py-3 text-sm font-medium text-ink transition hover:border-navy hover:text-navy">
              Read the market brief
            </a>
          </div>
        </div>
        <aside class="reveal border border-line bg-panel">
          <div class="flex items-center justify-between border-b border-line px-5 py-3">
            <span class="text-[11px] font-semibold tracking-[0.18em] text-navy uppercase">NEPSE at a glance</span>
            <span class="text-[11px] text-muted">mid-2026</span>
          </div>
          <dl class="divide-y divide-line px-5">
            {company.snapshot.map((row) => (
              <div class="flex items-baseline justify-between gap-4 py-2.5">
                <dt class="text-[13px] text-muted">{row.label}</dt>
                <dd class="text-right text-[13px] font-semibold tabular-nums text-ink">{row.value}</dd>
              </div>
            ))}
          </dl>
          <p class="border-t border-line px-5 py-2.5 text-[11px] text-muted">
            Indicative published figures. Refer to SEBON and NEPSE for current data.
          </p>
        </aside>
      </div>
    </section>

    <!-- Stats band -->
    <section class="reveal border-b border-line bg-navy text-white">
      <div class="mx-auto grid max-w-6xl grid-cols-2 divide-x divide-white/15 px-6 md:grid-cols-4">
        {company.stats.map((s) => (
          <div class="px-4 py-6 text-center first:pl-0">
            <p class="font-serif text-2xl font-semibold tabular-nums">{s.value}</p>
            <p class="mt-1 text-[11px] tracking-wide text-white/70 uppercase">{s.label}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Services -->
    <Section id="services" label="What we do" heading="Advisory Services">
      <div class="reveal grid gap-px overflow-hidden border border-line bg-line md:grid-cols-2">
        {company.services.map((s, i) => (
          <div class="bg-paper p-6 transition-colors hover:bg-panel">
            <p class="font-serif text-[13px] text-muted tabular-nums">0{i + 1}</p>
            <h3 class="mt-1 font-serif text-lg font-semibold text-ink">{s.title}</h3>
            <p class="mt-2 text-[14px] leading-relaxed text-muted">{s.body}</p>
          </div>
        ))}
      </div>
    </Section>

    <!-- Process -->
    <Section id="process" label="How we work" heading="From enquiry to ongoing review">
      <ol class="reveal grid gap-8 md:grid-cols-5 md:gap-6">
        {company.process.map((step, i) => (
          <li class="relative pl-10 md:pt-11 md:pl-0">
            {i < company.process.length - 1 && (
              <span class="absolute top-7 bottom-2 left-[11px] w-px bg-line md:top-3 md:bottom-auto md:left-9 md:right-[-12px] md:h-px md:w-auto" aria-hidden="true"></span>
            )}
            <span class="absolute top-0 left-0 flex h-6 w-6 items-center justify-center rounded-full border border-navy bg-paper font-serif text-[11px] font-semibold text-navy tabular-nums md:top-0">
              {i + 1}
            </span>
            <h3 class="font-serif text-[16px] font-semibold text-ink">{step.title}</h3>
            <p class="mt-1.5 text-[13.5px] leading-relaxed text-muted">{step.body}</p>
          </li>
        ))}
      </ol>
    </Section>

    <!-- Capital Market -->
    <Section id="market" label="Market brief" heading="Nepal's Capital Market" alt>
      <div class="reveal space-y-4 text-[15px] leading-relaxed text-ink/85">
        {company.market.intro.map((p) => <p>{p}</p>)}
      </div>

      <div class="mt-10 grid gap-x-10 gap-y-8 md:grid-cols-2">
        {company.market.analysis.map((a) => (
          <div class="reveal border-l-2 border-navy pl-4">
            <h4 class="text-[13px] font-semibold text-navy uppercase">{a.title}</h4>
            <p class="mt-1.5 text-[13.5px] leading-relaxed text-muted">{a.body}</p>
          </div>
        ))}
      </div>

      <h3 class="mt-12 font-serif text-lg font-semibold text-ink">Sector weightings</h3>
      <div class="mt-4 overflow-x-auto border border-line bg-paper">
        <table class="w-full min-w-[680px] border-collapse text-left text-[13px]">
          <thead>
            <tr class="border-b border-line bg-panel">
              <th class="px-4 py-2.5 text-[11px] font-semibold tracking-[0.14em] text-navy uppercase">Sector</th>
              <th class="px-4 py-2.5 text-[11px] font-semibold tracking-[0.14em] text-navy uppercase">Approx. market cap</th>
              <th class="px-4 py-2.5 text-[11px] font-semibold tracking-[0.14em] text-navy uppercase">Structural trend</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {company.market.sectors.map((s) => (
              <tr class="align-top transition-colors hover:bg-panel">
                <td class="px-4 py-3 font-medium text-ink">{s.name}</td>
                <td class="px-4 py-3 text-muted tabular-nums">{s.cap}</td>
                <td class="px-4 py-3 text-muted">{s.trend}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-2 text-[11px] text-muted">{company.market.sectorNote}</p>

      <h3 class="mt-10 font-serif text-lg font-semibold text-ink">Structural considerations</h3>
      <ul class="mt-3 grid gap-x-10 gap-y-2 md:grid-cols-2">
        {company.market.considerations.map((c) => (
          <li class="border-t border-line py-2.5 text-[14px] leading-relaxed text-muted">
            <span class="font-semibold text-ink">{c.title}</span> — {c.body}
          </li>
        ))}
      </ul>
    </Section>

    <!-- Share Market -->
    <Section id="share-market" label="For investors" heading="The Share Market">
      <p class="text-[15px] leading-relaxed text-ink/85">{company.shareMarket.intro}</p>
      <dl class="mt-8 grid gap-px overflow-hidden border border-line bg-line md:grid-cols-2">
        {company.shareMarket.features.map((f) => (
          <div class="bg-paper p-5">
            <dt class="text-[13px] font-semibold text-navy uppercase">{f.title}</dt>
            <dd class="mt-1.5 text-[14px] leading-relaxed text-muted">{f.body}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-8 border-l-2 border-navy pl-5 text-[15px] leading-relaxed text-ink">
        {company.shareMarket.closing}
      </p>
    </Section>

    <!-- Opportunities -->
    <Section id="opportunities" label="Beyond the exchange" heading="Investment Opportunities in Nepal" alt>
      <p class="text-[15px] leading-relaxed text-ink/85">{company.opportunities.intro}</p>
      <dl class="mt-8 grid gap-px overflow-hidden border border-line bg-line md:grid-cols-2 lg:grid-cols-3">
        {company.opportunities.items.map((o) => (
          <div class="bg-paper p-5">
            <dt class="text-[13px] font-semibold text-navy uppercase">{o.title}</dt>
            <dd class="mt-1.5 text-[14px] leading-relaxed text-muted">{o.body}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-8 border-l-2 border-navy pl-5 text-[15px] leading-relaxed text-ink">
        {company.opportunities.closing}
      </p>
    </Section>

    <!-- FDI -->
    <Section id="fdi" label="For international capital" heading="Foreign Direct Investment in Nepal">
      <p class="text-[15px] leading-relaxed text-ink/85">{company.fdi.intro}</p>
      <ol class="mt-8 grid gap-x-10 md:grid-cols-2">
        {company.fdi.highlights.map((h, i) => (
          <li class="grid grid-cols-[28px_1fr] gap-2 border-t border-line py-3.5">
            <span class="font-serif text-[13px] text-muted tabular-nums">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <p class="text-[14px] font-semibold text-ink">{h.title}</p>
              <p class="mt-0.5 text-[14px] leading-relaxed text-muted">{h.body}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="mt-8 border-l-2 border-navy pl-5 text-[15px] leading-relaxed text-ink">
        {company.fdi.closing}
      </p>
    </Section>

    <!-- About -->
    <Section id="about" label="Who we are" heading={company.about.heading} alt>
      <p class="reveal text-[15px] leading-relaxed text-ink/85">{company.about.body}</p>
      <dl class="mt-10 grid gap-x-10 gap-y-8 md:grid-cols-2">
        {company.about.points.map((p) => (
          <div class="reveal border-l-2 border-navy pl-4">
            <dt class="text-[13px] font-semibold text-navy uppercase">{p.title}</dt>
            <dd class="mt-1 text-[13.5px] leading-relaxed text-muted">{p.body}</dd>
          </div>
        ))}
      </dl>
    </Section>

    <!-- Contact -->
    <Section id="contact" label="Get in touch" heading="Contact the firm">
      <div class="reveal grid gap-10 lg:grid-cols-[1fr_1fr]">
        <dl class="divide-y divide-line border-y border-line text-[14px]">
          <div class="grid grid-cols-[120px_1fr] gap-2 py-3.5">
            <dt class="text-[11px] font-semibold tracking-[0.14em] text-navy uppercase pt-0.5">Email</dt>
            <dd>
              <a href={`mailto:${company.email}`} class="text-navy underline-offset-2 hover:underline">{company.email}</a>
            </dd>
          </div>
          {company.phones.map((p, i) => (
            <div class="grid grid-cols-[120px_1fr] gap-2 py-3.5">
              <dt class="text-[11px] font-semibold tracking-[0.14em] text-navy uppercase pt-0.5">{i === 0 ? 'Telephone' : ''}</dt>
              <dd><a href={`tel:${p.tel}`} class="text-ink hover:text-navy">{p.display}</a></dd>
            </div>
          ))}
          <div class="grid grid-cols-[120px_1fr] gap-2 py-3.5">
            <dt class="text-[11px] font-semibold tracking-[0.14em] text-navy uppercase pt-0.5">Office</dt>
            <dd class="text-muted">Kathmandu, Nepal</dd>
          </div>
          <div class="grid grid-cols-[120px_1fr] gap-2 py-3.5">
            <dt class="text-[11px] font-semibold tracking-[0.14em] text-navy uppercase pt-0.5">Hours</dt>
            <dd class="text-muted">{company.hours}</dd>
          </div>
        </dl>
        <div class="border border-line bg-panel p-6">
          <h3 class="font-serif text-lg font-semibold text-ink">Making an enquiry</h3>
          <p class="mt-2 text-[14px] leading-relaxed text-muted">
            Write to us with a short note on your objectives, capital range and time horizon.
            We reply within one business day. FDI enquiries should include the target sector
            and investor country of origin.
          </p>
          <a href={`mailto:${company.email}`} class="mt-5 inline-block bg-navy px-5 py-2.5 text-sm font-medium text-white transition hover:bg-navy-dark">
            Email {company.email}
          </a>
        </div>
      </div>
    </Section>
  </main>

  <footer class="bg-navy-dark text-white/70">
    <div class="mx-auto max-w-6xl px-6 py-12">
      <div class="grid gap-8 md:grid-cols-[1.4fr_1fr]">
        <div>
          <div class="flex items-center gap-3">
            <span class="flex h-8 w-8 items-center justify-center bg-paper/10 font-serif text-sm font-bold text-white">B</span>
            <span class="font-serif text-[16px] font-semibold text-white">{company.name}</span>
          </div>
          <p class="mt-3 max-w-md text-[13px] leading-relaxed">
            Investment advisory for NEPSE equities, debentures, mutual funds and foreign direct
            investment into Nepal.
          </p>
        </div>
        <div>
          <p class="text-[11px] font-semibold tracking-[0.18em] text-white uppercase">Contact</p>
          <ul class="mt-3 space-y-1.5 text-[13px]">
            <li><a href={`mailto:${company.email}`} class="hover:text-white">{company.email}</a></li>
            {company.phones.map((p) => (
              <li><a href={`tel:${p.tel}`} class="hover:text-white">{p.display}</a></li>
            ))}
            <li>{company.hours}</li>
          </ul>
        </div>
      </div>
      <nav class="mt-10 flex flex-wrap gap-x-8 gap-y-2 border-t border-white/10 pt-6 text-[13px]" aria-label="Footer">
        {company.nav.map((item) => (
          <a href={item.href} class="hover:text-white">{item.label}</a>
        ))}
      </nav>
    </div>
    <div class="border-t border-white/10">
      <div class="mx-auto max-w-6xl px-6 py-6">
        <p class="max-w-4xl text-[11px] leading-relaxed">{company.disclaimer}</p>
        <div class="mt-4 flex items-center justify-between text-[12px]">
          <p>&copy; {year} {company.name}. All rights reserved.</p>
          <a href="#top" class="text-white/70 transition hover:text-white">&uarr; Back to top</a>
        </div>
      </div>
    </div>
  </footer>

  <script type="application/ld+json" is:inline set:html={jsonLd} />
</Layout>
