---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { company } from '../content/company';
---

<Layout title={`Page not found — ${company.name}`} description="The page you requested could not be found.">
  <Header />
  <main class="mx-auto flex min-h-[60vh] max-w-6xl flex-col items-start justify-center px-6 py-24">
    <p class="text-[11px] font-semibold tracking-[0.18em] text-navy uppercase">Error 404</p>
    <h1 class="mt-3 font-serif text-4xl font-semibold text-ink md:text-5xl">This trail doesn't lead anywhere.</h1>
    <p class="mt-4 max-w-md text-[15px] leading-relaxed text-muted">
      The page you're looking for doesn't exist or has moved. Head back to the
      top of the site, or write to us at
      <a href={`mailto:${company.email}`} class="text-navy underline-offset-2 hover:underline">{company.email}</a>.
    </p>
    <a href="/" class="mt-8 inline-block bg-navy px-6 py-3 text-sm font-medium text-white transition hover:bg-navy-dark">
      Back to homepage
    </a>
  </main>
</Layout>
