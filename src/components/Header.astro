---
import { company } from '../content/company';
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-navy-950/90 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="#top" class="flex items-center gap-2">
      <svg viewBox="0 0 64 64" class="h-8 w-8" aria-hidden="true">
        <path d="M12 46 L28 20 L36 33 L42 24 L52 46 Z" fill="#d9a441" />
        <path d="M28 20 L33 28.5 L28 31 L23 28.5 Z" fill="#faf7f0" />
      </svg>
      <span class="font-serif text-lg font-semibold text-white">{company.name}</span>
    </a>
    <nav class="hidden items-center gap-6 md:flex">
      {company.nav.map((item) => (
        <a href={item.href} class="text-sm font-medium text-sand-100/80 transition hover:text-gold-400">
          {item.label}
        </a>
      ))}
    </nav>
    <button
      id="menu-btn"
      class="md:hidden rounded p-2 text-sand-100 hover:bg-white/10"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>
  <nav id="mobile-nav" class="hidden md:hidden border-t border-white/10 bg-navy-950 px-6 py-4">
    <div class="flex flex-col gap-3">
      {company.nav.map((item) => (
        <a href={item.href} class="mobile-link text-sm font-medium text-sand-100/90 hover:text-gold-400">
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>
<script>
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
  document.querySelectorAll('.mobile-link').forEach((a) =>
    a.addEventListener('click', () => nav?.classList.add('hidden'))
  );
</script>
