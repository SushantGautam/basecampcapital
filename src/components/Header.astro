---
import { company } from '../content/company';
---

<header class="sticky top-0 z-50 border-b border-line bg-paper">
  <div class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4">
    <a href="#top" class="font-serif text-lg font-semibold tracking-tight text-forest">
      {company.name}
    </a>
    <nav class="hidden items-center gap-7 md:flex">
      {company.nav.map((item) => (
        <a href={item.href} class="text-[13px] font-medium text-muted transition hover:text-forest">
          {item.label}
        </a>
      ))}
    </nav>
    <button
      id="menu-btn"
      class="p-2 text-ink md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>
  <nav id="mobile-nav" class="hidden border-t border-line px-6 py-4 md:hidden">
    <div class="flex flex-col gap-3">
      {company.nav.map((item) => (
        <a href={item.href} class="mobile-link text-sm font-medium text-ink">{item.label}</a>
      ))}
    </div>
  </nav>
</header>
<script>
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
  document.querySelectorAll('.mobile-link').forEach((a) =>
    a.addEventListener('click', () => nav?.classList.add('hidden'))
  );
</script>
