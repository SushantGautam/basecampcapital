---
import { company } from '../content/company';
import ThemeToggle from './ThemeToggle.astro';
import SocialIcons from './SocialIcons.astro';
---

<div class="bg-navy-dark text-white/85">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-1 px-6 py-1.5 text-[11px]">
    <span>Kathmandu, Nepal</span>
    <div class="flex items-center gap-5">
      {company.phones.map((p) => (
        <a href={`tel:${p.tel}`} class="hover:text-white">{p.display}</a>
      ))}
      <a href={`mailto:${company.email}`} class="hidden hover:text-white sm:inline">{company.email}</a>
      <span class="hidden h-3.5 w-px bg-white/25 sm:block" aria-hidden="true"></span>
      <SocialIcons className="text-white/70 hover:text-white" />
    </div>
  </div>
</div>
<header class="sticky top-0 z-50 border-b border-line bg-paper">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3.5">
    <a href="#top" class="flex items-center gap-3">
      <span class="flex h-10 w-10 items-center justify-center rounded-md border border-line bg-white"><img src="/logo-mark.png" alt="" width="32" height="25" class="w-8" /></span>
      <span class="leading-tight">
        <span class="block font-serif text-[17px] font-semibold tracking-tight text-ink">{company.name}</span>
        <span class="block text-[10px] tracking-[0.18em] text-muted uppercase">Investment Advisory</span>
      </span>
    </a>
    <nav class="hidden items-center gap-6 lg:flex">
      {company.nav.map((item) => (
        <a href={item.href} class="nav-link text-[13px] font-medium text-ink/75 hover:text-navy">
          {item.label}
        </a>
      ))}
      <a href="#contact" class="border border-navy px-4 py-2 text-[13px] font-medium text-navy transition hover:bg-navy hover:text-white">
        Enquire
      </a>
      <ThemeToggle />
    </nav>
    <div class="flex items-center lg:hidden">
      <ThemeToggle />
      <button id="menu-btn" class="p-2 text-ink" aria-label="Toggle menu" aria-expanded="false">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="hidden border-t border-line bg-paper px-6 py-4 lg:hidden">
    <div class="flex flex-col gap-3">
      {company.nav.map((item) => (
        <a href={item.href} class="mobile-link text-sm font-medium text-ink">{item.label}</a>
      ))}
      <a href="#contact" class="mobile-link mt-1 inline-block w-fit border border-navy px-4 py-2 text-sm font-medium text-navy">Enquire</a>
    </div>
  </nav>
</header>
<script>
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
  document.querySelectorAll('.mobile-link').forEach((a) =>
    a.addEventListener('click', () => nav?.classList.add('hidden'))
  );
</script>
