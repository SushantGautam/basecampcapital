---
interface Props {
  id: string;
  num: string;
  heading: string;
}

const { id, num, heading } = Astro.props;
---

<section id={id} class="border-t border-line">
  <div class="mx-auto max-w-4xl px-6 py-16 md:py-20">
    <div class="flex items-baseline gap-4">
      <span class="font-serif text-sm text-muted tabular-nums">{num}</span>
      <h2 class="font-serif text-2xl md:text-3xl font-semibold tracking-tight text-ink">{heading}</h2>
    </div>
    <div class="mt-2 border-b border-line"></div>
    <div class="mt-8">
      <slot />
    </div>
  </div>
</section>
