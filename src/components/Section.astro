---
interface Props {
  id: string;
  eyebrow: string;
  heading: string;
  dark?: boolean;
}

const { id, eyebrow, heading, dark = false } = Astro.props;
---

<section id={id} class={dark ? 'bg-navy-900 text-sand-50' : 'bg-sand-50 text-slate-700'}>
  <div class="mx-auto max-w-5xl px-6 py-20 md:py-28">
    <p class="mb-3 text-sm font-semibold tracking-widest uppercase text-gold-500">{eyebrow}</p>
    <h2 class={`font-serif text-3xl md:text-4xl font-semibold tracking-tight ${dark ? 'text-white' : 'text-navy-900'}`}>
      {heading}
    </h2>
    <div class="mt-3 h-1 w-16 rounded bg-gold-400"></div>
    <div class="mt-8">
      <slot />
    </div>
  </div>
</section>
